# =============================================================================
# AI NEWS VERIFICATION SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================

# --- LLM INFERENCE (GROQ) ---
# Get free API key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# --- REAL-TIME NEWS & WEB SEARCH ---
# Get free API key at: https://newsapi.org (100 req/day)
NEWS_API_KEY=your-news-api-key-here

# Optional: Get free API key at: https://serpapi.com (100 searches/month)
SERPAPI_KEY=your-serpapi-key-here

# --- QDRANT VECTOR DATABASE ---
# Local Docker instance: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
# Or Qdrant Cloud: https://cloud.qdrant.io
# QDRANT_URL=https://xxxxxx-xxxxx.eu-central.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=news_evidence

# --- EMBEDDINGS (FastEmbed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- SERVER CONFIGURATION ---
PORT=8000
HOST=0.0.0.0
DEBUG=false